# LineupCast OS — Production Environment
# Copy this file to .env and fill in the values before deploying.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=production
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Database name created on first start.
POSTGRES_DB=lineupcast
# Database user. Do NOT use "postgres" in production.
POSTGRES_USER=lineupcast
# REQUIRED — strong password with at least 16 characters.
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis is used for caching match data and prediction results.
# No password is set by default; secure Redis at the network level
# or add --requirepass to the redis command in docker-compose.prod.yml.
REDIS_URL=redis://redis:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use: "openai-compatible" | "huggingface"
LLM_PROVIDER=openai-compatible

# OpenAI-compatible settings (works with OpenAI, Azure, local servers, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# HuggingFace Inference Endpoint settings (alternative provider)
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ID=
HUGGINGFACE_ENDPOINT_URL=
HUGGINGFACE_ENDPOINT_TOKEN=

# ── Football Data Provider Keys ──────────────────────────────────────────────
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Optional alternative providers
FBREF_API_KEY=
STATBOMB_API_KEY=
OPENFOOTBALL_DATA_URL=

# ── Safety Flags ─────────────────────────────────────────────────────────────
# Enable AI-generated match narration.
ENABLE_AI_NARRATION=true
# Enable betting-related advice output. Keep false unless legally cleared.
ENABLE_BETTING_ADVICE=false
# Require disclaimer text on predictions.
REQUIRE_DISCLAIMER=true
# Allow fallback to synthetic/demo data when live data is unavailable.
ALLOW_SYNTHETIC_DATA=false
# Log full LLM prompts to stdout (disable in production to avoid leaking data).
LOG_LLM_PROMPTS=false

# ── Provider Mode ────────────────────────────────────────────────────────────
# "mock" = serve demo data, "model" = run prediction engine via bridge.
LINEUPCAST_PROVIDER_MODE=model

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the browser uses to reach the API. When behind Nginx, use a relative
# path so the reverse proxy handles routing.
NEXT_PUBLIC_API_URL=/api
